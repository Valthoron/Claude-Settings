{
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "autoUpdatesChannel": "latest",
    "editorMode": "normal",
    "effortLevel": "high",
    "enabledPlugins": {
        "asd-ste100@chele-bi": false,
        "swift-lsp@claude-plugins-official": true,
        "xcode-integration@xcode": true
    },
    "extraKnownMarketplaces": {
        "chele-bi": {
            "source": {
                "source": "git",
                "url": "https://github.com/woosal1337/blog.git"
            }
        },
        "gitkraken": {
            "source": {
                "path": "/Users/Serdar/.claude/plugins/marketplaces/gitkraken",
                "source": "directory"
            }
        },
        "nocodb-agent-skills": {
            "source": {
                "repo": "nocodb/agent-skills",
                "source": "github"
            }
        },
        "xcode": {
            "source": {
                "name": "xcode",
                "plugins": [
                    {
                        "name": "xcode-integration",
                        "source": {
                            "command": "xcrun agent plugin path --plugin-format claude",
                            "source": "command"
                        }
                    }
                ],
                "source": "settings"
            }
        }
    },
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "command": "/Users/Serdar/.claude/hooks/guard-outward-git.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "args": [
                            "save"
                        ],
                        "command": "/Users/Serdar/.claude/hooks/settings-sync.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "args": [],
                        "command": "/Users/Serdar/.claude/hooks/config-check.sh",
                        "timeout": 10,
                        "type": "command"
                    },
                    {
                        "args": [
                            "save"
                        ],
                        "command": "/Users/Serdar/.claude/hooks/settings-sync.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "startup"
            }
        ]
    },
    "inputNeededNotifEnabled": false,
    "model": "opus",
    "permissions": {
        "ask": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(gh pr create)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge)",
            "Bash(gh pr merge *)",
            "Bash(gh release create)",
            "Bash(gh release create *)"
        ],
        "defaultMode": "plan"
    },
    "remoteControlAtStartup": false,
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Şirinliyor",
            "Köklüyor",
            "Yardırıyor",
            "Gagalıyor",
            "Butuböküyor",
            "Kasıyor",
            "Zagalıyor",
            "Şeberiyor"
        ]
    },
    "syncClaudeAiSkills": false,
    "theme": "dark",
    "useAutoModeDuringPlan": true
}
