{
    "permissions": {
        "defaultMode": "plan",
        "ask": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(gh pr create)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge)",
            "Bash(gh pr merge *)",
            "Bash(gh release create)",
            "Bash(gh release create *)"
        ]
    },
    "model": "opus",
    "enabledPlugins": {
        "gitkraken-hooks@gitkraken": true
    },
    "extraKnownMarketplaces": {
        "gitkraken": {
            "source": {
                "source": "directory",
                "path": "/Users/Serdar/.claude/plugins/marketplaces/gitkraken"
            }
        },
        "nocodb-agent-skills": {
            "source": {
                "source": "github",
                "repo": "nocodb/agent-skills"
            }
        }
    },
    "effortLevel": "high",
    "theme": "dark",
    "editorMode": "normal",
    "remoteControlAtStartup": false,
    "useAutoModeDuringPlan": true,
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/Users/Serdar/.claude/hooks/guard-outward-git.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/Users/Serdar/.claude/hooks/config-check.sh",
                        "args": [],
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Şirinliyor",
            "Köklüyor",
            "Yardırıyor"
        ]
    },
    "inputNeededNotifEnabled": false,
    "autoUpdatesChannel": "latest"
}
