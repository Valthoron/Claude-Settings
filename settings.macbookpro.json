{
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "autoUpdatesChannel": "latest",
    "editorMode": "normal",
    "effortLevel": "high",
    "enabledPlugins": {
        "gitkraken-hooks@gitkraken": true
    },
    "extraKnownMarketplaces": {
        "gitkraken": {
            "source": {
                "path": "/Users/Serdar/.claude/plugins/marketplaces/gitkraken",
                "source": "directory"
            }
        },
        "nocodb-agent-skills": {
            "source": {
                "repo": "nocodb/agent-skills",
                "source": "github"
            }
        }
    },
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "command": "/Users/Serdar/.claude/hooks/guard-outward-git.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "args": [],
                        "command": "/Users/Serdar/.claude/hooks/config-check.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "startup"
            }
        ]
    },
    "inputNeededNotifEnabled": false,
    "model": "opus",
    "permissions": {
        "ask": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(gh pr create)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge)",
            "Bash(gh pr merge *)",
            "Bash(gh release create)",
            "Bash(gh release create *)"
        ],
        "defaultMode": "plan"
    },
    "remoteControlAtStartup": false,
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Şirinliyor",
            "Köklüyor",
            "Yardırıyor"
        ]
    },
    "theme": "dark",
    "useAutoModeDuringPlan": false
}
