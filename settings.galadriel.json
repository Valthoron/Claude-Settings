{
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "autoMode": {
        "allow": [
            "$defaults",
            "Running `bash /tmp/rename_movies.sh` on ivybush, which renames, moves, creates and deletes files only under /home/qbtuser/Downloads, is allowed once the user has approved the rename plan in this session.",
            "Running `bash /tmp/rename_publications.sh` on ivybush, which renames, moves and creates files and folders only under /home/qbtuser/Downloads and removes only folders its own moves emptied, is allowed once the user has approved the rename plan in this session."
        ],
        "environment": [
            "$defaults",
            "Home LAN: galadriel (this machine), ivybush, prancingpony and greendragon are the user's own machines. Read-only diagnostics on them are routine."
        ]
    },
    "autoUpdatesChannel": "latest",
    "editorMode": "normal",
    "effortLevel": "high",
    "enabledPlugins": {
        "asd-ste100@chele-bi": false,
        "notion@claude-plugins-official": true,
        "skill-creator@claude-plugins-official": false,
        "swift-lsp@claude-plugins-official": false,
        "telemetry@builtin": false,
        "typesafe@typesafe-ai": false,
        "xcode-integration@xcode": false
    },
    "extraKnownMarketplaces": {
        "chele-bi": {
            "source": {
                "source": "git",
                "url": "https://github.com/woosal1337/blog.git"
            }
        },
        "nocodb-agent-skills": {
            "source": {
                "repo": "nocodb/agent-skills",
                "source": "github"
            }
        },
        "typesafe-ai": {
            "source": {
                "repo": "typesafe-ai/skills",
                "source": "github"
            }
        }
    },
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\guard-outward-git.ps1"
                        ],
                        "command": "powershell.exe",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash|PowerShell"
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\settings-sync.ps1",
                            "save"
                        ],
                        "command": "powershell.exe",
                        "timeout": 10,
                        "type": "command"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\config-check.ps1"
                        ],
                        "command": "powershell.exe",
                        "timeout": 10,
                        "type": "command"
                    },
                    {
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\settings-sync.ps1",
                            "save"
                        ],
                        "command": "powershell.exe",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "startup"
            }
        ]
    },
    "inputNeededNotifEnabled": false,
    "model": "opus",
    "modelSettings": {
        "claude-sonnet-5": {
            "effortLevel": "xhigh"
        }
    },
    "permissions": {
        "ask": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(gh pr create)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge)",
            "Bash(gh pr merge *)",
            "Bash(gh release create)",
            "Bash(gh release create *)"
        ],
        "defaultMode": "plan"
    },
    "remoteControlAtStartup": false,
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Şirinliyor",
            "Köklüyor",
            "Yardırıyor",
            "Gagalıyor",
            "Butuböküyor",
            "Kasıyor",
            "Zagalıyor",
            "Şeberiyor"
        ]
    },
    "syncClaudeAiSkills": false,
    "theme": "dark",
    "useAutoModeDuringPlan": true
}
