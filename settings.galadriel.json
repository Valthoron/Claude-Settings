{
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "autoUpdatesChannel": "latest",
    "editorMode": "normal",
    "effortLevel": "high",
    "enabledPlugins": {
        "gitkraken-hooks@gitkraken": false,
        "asd-ste100@chele-bi": false,
        "swift-lsp@claude-plugins-official": true
    },
    "extraKnownMarketplaces": {
        "gitkraken": {
            "source": {
                "path": "C:\\Users\\Serdar\\.claude\\plugins\\marketplaces\\gitkraken",
                "source": "directory"
            }
        },
        "nocodb-agent-skills": {
            "source": {
                "repo": "nocodb/agent-skills",
                "source": "github"
            }
        },
        "chele-bi": {
            "source": {
                "source": "git",
                "url": "https://github.com/woosal1337/blog.git"
            }
        }
    },
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\guard-outward-git.ps1"
                        ],
                        "command": "powershell.exe",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash|PowerShell"
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\config-check.ps1"
                        ],
                        "command": "powershell.exe",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "startup"
            }
        ]
    },
    "inputNeededNotifEnabled": false,
    "model": "sonnet",
    "permissions": {
        "ask": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(gh pr create)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge)",
            "Bash(gh pr merge *)",
            "Bash(gh release create)",
            "Bash(gh release create *)"
        ],
        "defaultMode": "plan"
    },
    "remoteControlAtStartup": false,
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Şirinliyor",
            "Köklüyor",
            "Yardırıyor",
            "Gagalıyor",
            "Butuböküyor",
            "Kasıyor",
            "Zagalıyor",
            "Şeberiyor"
        ]
    },
    "theme": "dark",
    "useAutoModeDuringPlan": true
}
