{
    "permissions": {
        "defaultMode": "plan",
        "ask": [
            "Bash(git push)",
            "Bash(git push *)",
            "Bash(gh pr create)",
            "Bash(gh pr create *)",
            "Bash(gh pr merge)",
            "Bash(gh pr merge *)",
            "Bash(gh release create)",
            "Bash(gh release create *)"
        ]
    },
    "model": "opus",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\config-check.ps1"
                        ],
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "C:\\Users\\Serdar\\.claude\\hooks\\guard-outward-git.ps1"
                        ],
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "gitkraken-hooks@gitkraken": true
    },
    "extraKnownMarketplaces": {
        "gitkraken": {
            "source": {
                "source": "directory",
                "path": "C:\\Users\\Serdar\\.claude\\plugins\\marketplaces\\gitkraken"
            }
        },
        "nocodb-agent-skills": {
            "source": {
                "source": "github",
                "repo": "nocodb/agent-skills"
            }
        }
    },
    "effortLevel": "high",
    "autoUpdatesChannel": "latest",
    "theme": "dark",
    "editorMode": "normal",
    "inputNeededNotifEnabled": false,
    "remoteControlAtStartup": false,
    "useAutoModeDuringPlan": true,
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "Şirinliyor",
            "Köklüyor",
            "Yardırıyor"
        ]
    }
}
